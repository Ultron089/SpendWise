{
  "manifest_version": 3,
  "name": "SpendWise",
  "version": "1.0.0",
  "description": "Smart Shopping Expense Analyzer",

  "permissions": ["storage"],
  "host_permissions": ["http://localhost:5000/*"],

  "action": {
    "default_popup": "src/popup/index.html"
  },

  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.in/*",
        "https://www.amazon.com/*",
        "https://www.flipkart.com/*",
        "https://www.myntra.com/*",
        "https://www.ajio.com/*",
        "https://blinkit.com/*",
        "https://www.zeptonow.com/*",
        "https://www.zepto.com/*"
      ],
      "js": ["content-scripts/contentScript.js"]
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["src/dashboard/index.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
